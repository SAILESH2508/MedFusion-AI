{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MedFusion AI Anatomical 3D Model Registry",
  "version": "1.0.0",
  "description": "Configuration and metadata registry for high-fidelity licensed 3D GLTF/GLB organ models (Zygote, BioDigital, NIH 3D, BodyParts3D).",
  "assetsRoot": "/models/organs/",
  "supportedFormats": ["glb", "gltf"],
  "compression": "Draco / KTX2",
  "organs": {
    "heart": {
      "id": "heart",
      "name": "Human Heart & Great Vessels",
      "fileName": "heart.glb",
      "scale": [0.85, 0.85, 0.85],
      "position": [0.12, 0.18, 0.12],
      "rotation": [0, -0.2, 0],
      "targetPolygons": 45000,
      "recommendedSources": [
        {
          "provider": "Zygote Media Group",
          "dataset": "Zygote 3D Heart Model (Solid 3D Anatomy)",
          "license": "Commercial / Enterprise (Zygote CAD)",
          "url": "https://www.3dscience.com/3D_Models/Human_Anatomy/Cardiovascular/Heart.php"
        },
        {
          "provider": "NIH 3D Print Exchange",
          "dataset": "Adult Heart with Coronary Arteries (ID: 3DPX-000458)",
          "license": "Public Domain / CC0",
          "url": "https://3d.nih.gov/entries/3DPX-000458"
        },
        {
          "provider": "BodyParts3D / DBCLS",
          "dataset": "FMA7088 (Heart)",
          "license": "CC-BY-SA 2.1 Japan",
          "url": "https://lifesciencedb.jp/bp3d/"
        }
      ],
      "biomarkers": ["cholesterol", "ldl", "hdl", "triglycerides", "systolic", "diastolic"],
      "diseaseType": "Heart Attack"
    },
    "lungs": {
      "id": "lungs",
      "name": "Human Respiratory System (Lungs & Bronchial Tree)",
      "fileName": "lungs.glb",
      "scale": [0.9, 0.9, 0.9],
      "position": [0, 0.44, 0],
      "rotation": [0, 0, 0],
      "targetPolygons": 55000,
      "recommendedSources": [
        {
          "provider": "Zygote Media Group",
          "dataset": "Zygote 3D Respiratory System",
          "license": "Commercial / Enterprise",
          "url": "https://www.zygote.com"
        },
        {
          "provider": "NIH 3D Print Exchange",
          "dataset": "Bilateral Lungs & Tracheobronchial Tree (ID: 3DPX-002130)",
          "license": "CC-BY 3.0",
          "url": "https://3d.nih.gov"
        }
      ],
      "biomarkers": ["oxygen saturation", "spo2", "peak flow"],
      "diseaseType": "Respiratory"
    },
    "liver": {
      "id": "liver",
      "name": "Human Liver & Gallbladder",
      "fileName": "liver.glb",
      "scale": [0.95, 0.95, 0.95],
      "position": [0.22, -0.42, 0.04],
      "rotation": [0, 0, 0],
      "targetPolygons": 32000,
      "recommendedSources": [
        {
          "provider": "Zygote Media Group",
          "dataset": "Zygote 3D Digestive System - Liver",
          "license": "Commercial / Enterprise",
          "url": "https://www.zygote.com"
        },
        {
          "provider": "NIH 3D Print Exchange",
          "dataset": "Human Liver Segmental Anatomy",
          "license": "CC-BY 3.0",
          "url": "https://3d.nih.gov"
        }
      ],
      "biomarkers": ["alt", "ast", "bilirubin", "ggt", "albumin"],
      "diseaseType": "Hepatic"
    },
    "kidneys": {
      "id": "kidneys",
      "name": "Human Kidneys & Renal Vasculature",
      "fileName": "kidneys.glb",
      "scale": [0.9, 0.9, 0.9],
      "position": [0, -0.64, -0.14],
      "rotation": [0, 0, 0],
      "targetPolygons": 38000,
      "recommendedSources": [
        {
          "provider": "Zygote Media Group",
          "dataset": "Zygote 3D Urinary System - Kidneys",
          "license": "Commercial / Enterprise",
          "url": "https://www.zygote.com"
        },
        {
          "provider": "NIH 3D Print Exchange",
          "dataset": "Human Kidneys with Renal Pelvis (ID: 3DPX-003841)",
          "license": "Public Domain / CC0",
          "url": "https://3d.nih.gov"
        }
      ],
      "biomarkers": ["creatinine", "urea", "bun", "egfr"],
      "diseaseType": "Renal"
    },
    "brain": {
      "id": "brain",
      "name": "Human Brain (Cerebrum, Cerebellum & Stem)",
      "fileName": "brain.glb",
      "scale": [0.85, 0.85, 0.85],
      "position": [0, 1.44, 0],
      "rotation": [0, 0, 0],
      "targetPolygons": 65000,
      "recommendedSources": [
        {
          "provider": "Zygote Media Group",
          "dataset": "Zygote 3D Brain & Nervous System",
          "license": "Commercial / Enterprise",
          "url": "https://www.zygote.com"
        },
        {
          "provider": "OpenAnatomy / Harvard SPL",
          "dataset": "SPL Brain Atlas 3D Surface Mesh",
          "license": "Open Research / Academic License",
          "url": "https://www.openanatomy.org"
        }
      ],
      "biomarkers": [],
      "diseaseType": "Neurological"
    }
  }
}
